# ============================================================
# HMeeting Production Environment Variables
# Copy this file to .env.production and fill in real values
# ============================================================

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Your production URL — MUST be https://. The app refuses to boot otherwise.
APP_URL=https://your.domain
AUTH_URL=https://your.domain
AUTH_TRUST_HOST=true

# Set to "true" so the rate limiter trusts X-Real-IP from nginx.
# Only enable this when nginx (on loopback) is the only thing forwarding
# to the Node process — otherwise clients can spoof the source IP.
TRUST_PROXY=true

# Resend email API key (get from resend.com)
RESEND_API_KEY=re_your_resend_api_key

# --- Field-level encryption (choose ONE) ---
#
# The app refuses to boot in production without a key. If BOTH
# AWS_SECRET_NAME and AWS_REGION are set it uses AWS and does NOT fall back to
# ENCRYPTION_KEY — so leave them unset on hosts without AWS access (Linode).
# Losing the key means losing every encrypted field: back it up.

# Option A: direct key on the box (what the Linode deploy uses)
ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Option B: AWS Secrets Manager — key never touches the VM
# aws secretsmanager create-secret --name hmmeeting/encryption-key --secret-string "$(openssl rand -base64 32)" --region us-east-1
# AWS_SECRET_NAME=hmmeeting/encryption-key
# AWS_REGION=us-east-1

# --- Backup encryption (separate key from field-level encryption) ---
# Needed only for `./deploy.sh backup` / `restore`.
# Option A: direct key (base64 of exactly 32 bytes)
# BACKUP_KEY=generate-with-openssl-rand-base64-32
# Option B: AWS Secrets Manager
# AWS_BACKUP_SECRET_NAME=hmmeeting/backup-key

# Optional: bootstrap the first admin before any DB roles exist.
# INITIAL_ADMIN_EMAIL=someone@horacemann.org

# Database (this is set automatically by docker-compose, but listed for reference)
# DATABASE_URL=file:/app/data/prod.db
